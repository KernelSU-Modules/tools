{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "listed",
        "rejected",
        "suspended",
        "archived"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "const": "github"
        },
        "repositoryId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "ownerId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fullName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "manifestPath": {
          "default": "module.yaml",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "host",
        "repositoryId",
        "ownerId",
        "fullName"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "pattern": "^[a-z0-9]{10}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "submit",
            "transfer"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "const": "github"
            },
            "repositoryId": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "ownerId": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "fullName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "manifestPath": {
              "default": "module.yaml",
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "host",
            "repositoryId",
            "ownerId",
            "fullName"
          ],
          "additionalProperties": false
        },
        "submittedBy": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "submittedByLogin": {
          "type": "string"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "telegram": {
          "type": "object",
          "properties": {
            "chatId": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "messageId": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "chatId",
            "messageId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "submissionId",
        "kind",
        "source",
        "submittedBy",
        "submittedAt"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "pattern": "^[a-z0-9]{10}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "submit",
            "transfer"
          ]
        },
        "submittedBy": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "decidedBy": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "decidedVia": {
          "type": "string",
          "enum": [
            "portal",
            "telegram",
            "auto"
          ]
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "spam",
            "violation",
            "bad-id",
            "squatting",
            "other"
          ]
        },
        "reason": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "telegram": {
          "type": "object",
          "properties": {
            "chatId": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "messageId": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "chatId",
            "messageId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "submissionId",
        "kind",
        "submittedBy",
        "submittedAt",
        "decision",
        "decidedBy",
        "decidedVia",
        "decidedAt"
      ],
      "additionalProperties": false
    },
    "moderation": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "suspend",
            "archive"
          ]
        },
        "by": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "type": "string",
          "enum": [
            "portal",
            "telegram",
            "auto"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "action",
        "by",
        "via",
        "at",
        "reason"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
