{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "modules": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[a-zA-Z][a-zA-Z0-9._-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "repositoryId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "fullName": {
            "type": "string"
          },
          "health": {
            "type": "string",
            "enum": [
              "ok",
              "stale",
              "error"
            ]
          },
          "installation": {
            "type": "string",
            "enum": [
              "present",
              "missing"
            ]
          },
          "lastSuccessAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "contentCommit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "stable": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "versionCode": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "publishedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                },
                "required": [
                  "tag",
                  "version",
                  "versionCode",
                  "publishedAt"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "maxVersionCode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "request": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "submissionId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]{10}$"
                  },
                  "repositoryId": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "latestTag": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "issues": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "severity": {
                          "type": "string",
                          "enum": [
                            "error",
                            "warning"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "maxLength": 300
                        }
                      },
                      "required": [
                        "code",
                        "severity"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "commit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "releaseId": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "submissionId",
                  "repositoryId",
                  "ok",
                  "checkedAt",
                  "latestTag",
                  "issues"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "repositoryId",
          "fullName",
          "health",
          "installation",
          "lastSuccessAt",
          "message",
          "contentCommit",
          "stable",
          "maxVersionCode",
          "request"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "modules"
  ],
  "additionalProperties": false
}
