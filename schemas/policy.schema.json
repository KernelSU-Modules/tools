{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "object",
      "properties": {
        "reservedPrefixes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reservedIds": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "zipMaxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "uncompressedMaxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCompressionRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxEntries": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "modulePropMaxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "manifestMaxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "docMaxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "imageMaxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "imagesMaxPerModule": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "imagesMaxTotalBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "imageMaxRedirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changelogMaxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "zipMaxBytes",
        "uncompressedMaxBytes",
        "maxCompressionRatio",
        "maxEntries",
        "modulePropMaxBytes",
        "manifestMaxBytes",
        "docMaxBytes",
        "imageMaxBytes",
        "imagesMaxPerModule",
        "imagesMaxTotalBytes",
        "imageMaxRedirects",
        "changelogMaxBytes"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "properties": {
        "keepReleases": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "keepReleases"
      ],
      "additionalProperties": false
    },
    "pending": {
      "type": "object",
      "properties": {
        "expireDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "expireDays"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "limits",
    "history",
    "pending"
  ],
  "additionalProperties": false
}
