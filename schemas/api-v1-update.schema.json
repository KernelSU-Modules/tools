{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "zipUrl": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "changelog": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    }
  },
  "required": [
    "version",
    "versionCode",
    "zipUrl",
    "changelog"
  ]
}
