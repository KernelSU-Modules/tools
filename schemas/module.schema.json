{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "homepage": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "support": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "tags": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,31}$"
      }
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "metamodule": {
      "default": false,
      "type": "boolean"
    },
    "authors": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "starsRepository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\\/[A-Za-z0-9._-]{1,100}$"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "androidMinApi": {
          "type": "integer",
          "minimum": 21,
          "maximum": 99
        },
        "androidMaxApi": {
          "type": "integer",
          "minimum": 21,
          "maximum": 99
        },
        "architectures": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "arm64-v8a",
              "armeabi-v7a",
              "x86_64",
              "x86",
              "riscv64"
            ]
          }
        }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "assetPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/\\\\]+$"
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "summary",
    "description"
  ]
}
