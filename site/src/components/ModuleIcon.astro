---
import type { ApiModuleSummary } from '@kernelsu-modules/schema';

interface Props {
  module: Pick<ApiModuleSummary, 'id' | 'icon'>;
  name: string;
  size?: 'sm' | 'lg';
}
const { module: d, name, size = 'sm' } = Astro.props;
const box = size === 'lg' ? 'h-12 w-12 rounded-lg text-xl' : 'h-8 w-8 rounded-md text-sm';
const letter = (name.trim()[0] ?? d.id[0] ?? '?').toUpperCase();
---

{
  d.icon ? (
    <img src={`/${d.icon}`} alt="" width="64" height="64" loading="lazy" decoding="async" class={`${box} flex-none border border-line-muted bg-subtle object-cover`} />
  ) : (
    <span aria-hidden="true" class={`${box} flex-none inline-flex items-center justify-center border border-line-muted bg-subtle font-semibold text-muted`}>
      {letter}
    </span>
  )
}
