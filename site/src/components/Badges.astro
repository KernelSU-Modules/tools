---
import type { ApiModuleDetail } from '@kernelsu-modules/schema';
import type { Messages } from '../lib/i18n.ts';
import { date } from '../lib/format.ts';

interface Props {
  module: Pick<ApiModuleDetail, 'metamodule' | 'kind' | 'health'>;
  m: Messages;
  /** Detail page: also show the immutable-release and sync-ok badges. */
  full?: boolean;
}
const { module: d, m, full = false } = Astro.props;
const stale = d.health.status === 'stale';
---

{d.metamodule && <span class="label label-done badge-meta">{m.metamodule}</span>}
{
  d.kind === 'script' && (
    <span title={m.scriptTitle} class="label label-accent badge-script">
      {m.script}
    </span>
  )
}
{
  full && (
    <span title={m.immutableTitle} class="label label-success badge-immutable">
      {m.immutable}
    </span>
  )
}
{
  stale ? (
    <span title={m.healthStaleTitle(date(d.health.lastSuccessAt) || m.never)} class="label label-attention badge-stale">
      {m.healthStale}
    </span>
  ) : (
    full && <span class="label label-accent badge-ok">{m.healthOk}</span>
  )
}
