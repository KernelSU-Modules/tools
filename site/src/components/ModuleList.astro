---
import { MESSAGES, type UiLocale } from '../lib/i18n.ts';
import { listOrder } from '../lib/data.ts';
import { safeHref } from '../lib/format.ts';
import { siteData } from '../lib/load.ts';
import ModuleCard from './ModuleCard.astro';

interface Props {
  ui: UiLocale;
}
const { ui } = Astro.props;
const m = MESSAGES[ui];
const data = siteData();
const mods = listOrder(data.modules);
---

<section class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="min-w-0">
    <h1 class="text-[28px] leading-tight font-semibold">{m.siteTitle}</h1>
    <p class="mt-1 text-muted">{m.listSubtitle(mods.length)}</p>
  </div>
  <a href={safeHref(data.portalUrl)} class="btn btn-primary self-start sm:self-auto">
    <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M7.75 2a.75.75 0 0 1 .75.75V7h4.25a.75.75 0 0 1 0 1.5H8.5v4.25a.75.75 0 0 1-1.5 0V8.5H2.75a.75.75 0 0 1 0-1.5H7V2.75A.75.75 0 0 1 7.75 2Z"></path>
    </svg>
    {m.publishModule}
  </a>
</section>

<section class="box" aria-labelledby="all-modules">
  <div class="box-header flex-wrap gap-y-2">
    <h2 id="all-modules" class="box-title mr-auto">{m.allModules}</h2>
    {
      mods.length > 0 && (
        <div id="list-tools" hidden class="order-last flex w-full flex-wrap items-center gap-x-4 gap-y-2 md:order-none md:w-auto">
          <input id="filter" type="search" autocomplete="off" placeholder={m.filterPlaceholder} aria-label={m.searchLabel} class="form-control min-w-0 flex-[1_1_14rem] py-[3px] md:w-64 md:flex-none" />
          <label class="inline-flex items-center gap-1.5 text-muted">
            <input id="filter-meta" type="checkbox" class="accent-[var(--ksu-accent)]" />
            {m.metamodulesOnly}
          </label>
          <label class="inline-flex items-center gap-1.5 text-muted">
            {m.sortLabel}
            <select id="sort" class="form-control py-[3px] pl-2 pr-1">
              <option value="updated">{m.sortUpdated}</option>
              <option value="name">{m.sortName}</option>
            </select>
          </label>
        </div>
      )
    }
    <span id="count" class="counter" title={m.modulesCount(mods.length)} data-one={m.modulesCount(1)} data-many={m.modulesCount(2).replace('2', '{n}')}>
      {mods.length}
    </span>
  </div>
  {
    mods.length > 0 ? (
      <>
        <ul id="modules">
          {mods.map((mod) => (
            <ModuleCard module={mod.detail} ui={ui} />
          ))}
        </ul>
        <p id="no-results" hidden class="px-4 py-12 text-center text-muted">
          {m.noResults}
        </p>
      </>
    ) : (
      <div class="px-4 py-16 text-center">
        <svg class="mx-auto mb-3 h-6 w-6 text-muted" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="m8.878.392 5.25 3.045c.54.314.872.89.872 1.514v6.098a1.75 1.75 0 0 1-.872 1.514l-5.25 3.045a1.75 1.75 0 0 1-1.756 0l-5.25-3.045A1.75 1.75 0 0 1 1 11.049V4.951c0-.624.332-1.201.872-1.514L7.122.392a1.75 1.75 0 0 1 1.756 0ZM7.875 1.69l-4.63 2.685L8 7.133l4.755-2.758-4.63-2.685a.248.248 0 0 0-.25 0ZM2.5 5.677v5.372c0 .09.047.171.125.216l4.625 2.683V8.432Zm6.25 8.271 4.625-2.683a.25.25 0 0 0 .125-.216V5.677L8.75 8.432Z"></path>
        </svg>
        <h3 class="text-xl font-semibold">{m.noModulesTitle}</h3>
        <p class="mt-1 text-muted">{m.noModulesText}</p>
      </div>
    )
  }
</section>
