---
import type { ApiModuleDetail } from '@kernelsu-modules/schema';
import { MESSAGES, type UiLocale } from '../lib/i18n.ts';
import { detailUrl } from '../lib/data.ts';
import { date, safeHref, safeWebHref } from '../lib/format.ts';
import Badges from './Badges.astro';
import ModuleIcon from './ModuleIcon.astro';

interface Props {
  module: ApiModuleDetail;
  ui: UiLocale;
}
const { module: d, ui } = Astro.props;
const m = MESSAGES[ui];
const authors = d.authors.slice(0, 3).map((a) => a.name);
const moreAuthors = d.authors.length > 3;
const ext = { rel: 'nofollow noopener noreferrer' };
const href = `/${detailUrl(ui, d.id)}`;
---

<li class="module-card grid grid-cols-[32px_minmax(0,1fr)] gap-x-3 gap-y-3 border-t border-line-muted p-4 first:border-t-0 sm:grid-cols-[32px_minmax(0,1fr)_auto]" data-id={d.id} data-meta={d.metamodule ? '1' : '0'} data-updated={d.updatedAt}>
  <ModuleIcon module={d} name={d.name} size="sm" />
  <div class="min-w-0">
    <div class="mb-1.5 flex min-w-0 flex-wrap items-center gap-2">
      <h3 class="min-w-0 text-lg leading-tight font-semibold break-words"><a href={href} class="link">{d.name}</a></h3>
      <span class="label max-w-full break-all whitespace-normal">{d.id}</span>
      <Badges module={d} m={m} />
    </div>
    {d.summary && <p class="line-clamp-3 text-muted">{d.summary}</p>}
    <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted">
      <span class="label label-success" title={m.latestVersion}>{d.stable.version}</span>
      {
        authors.length > 0 && (
          <span class="inline-flex min-w-0 items-center gap-1">
            <svg class="h-3.5 w-3.5 flex-none" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M10.561 8.073a6.005 6.005 0 0 1 3.432 5.142.75.75 0 1 1-1.498.07 4.5 4.5 0 0 0-8.99 0 .75.75 0 0 1-1.498-.07 6.004 6.004 0 0 1 3.431-5.142 3.999 3.999 0 1 1 5.123 0ZM10.5 5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"></path>
            </svg>
            <span class="sr-only">{m.authors}:</span>
            <span class="truncate">{authors.join(', ')}{moreAuthors && ', …'}</span>
          </span>
        )
      }
      {d.license && <span>{d.license}</span>}
      <span>{m.updatedPrefix} <time datetime={d.updatedAt} data-relative>{date(d.updatedAt)}</time></span>
    </div>
  </div>
  <div class="col-start-2 flex flex-wrap items-start gap-2 sm:col-start-3 sm:row-start-1">
    {d.homepage && <a href={safeWebHref(d.homepage)} {...ext} class="btn btn-sm">{m.homepage}</a>}
    <a href={safeHref(d.source.url)} {...ext} class="btn btn-sm">{m.source}</a>
  </div>
</li>
