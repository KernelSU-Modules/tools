---
import type { ApiModuleDetail } from '@kernelsu-modules/schema';
import { MESSAGES, type UiLocale } from '../lib/i18n.ts';
import { detailUrl } from '../lib/data.ts';
import { date } from '../lib/format.ts';
import Badges from './Badges.astro';
import ModuleIcon from './ModuleIcon.astro';

interface Props {
  module: ApiModuleDetail;
  ui: UiLocale;
}
const { module: d, ui } = Astro.props;
const m = MESSAGES[ui];
const authors = d.authors.slice(0, 3).map((a) => a.name);
const moreAuthors = d.authors.length > 3;
---

<li class="module-card" data-id={d.id} data-meta={d.metamodule ? '1' : '0'} data-updated={d.updatedAt}>
  <a
    href={`/${detailUrl(ui, d.id)}`}
    class="group relative flex h-full flex-col rounded-2xl border border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 p-6 hover:border-blue-500/50 hover:bg-gray-50 dark:hover:bg-slate-900 hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-300"
  >
    <div class="flex items-start gap-4 mb-3">
      <ModuleIcon module={d} name={d.name} />
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1 min-w-0">
          <h2 class="text-xl font-bold text-gray-900 dark:text-slate-100 truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            {d.name}
          </h2>
          <Badges module={d} m={m} />
        </div>
        <p class="font-mono text-xs text-gray-500 dark:text-slate-500 truncate">{d.id}</p>
        <div class="text-sm text-gray-500 dark:text-slate-400 mt-1 space-y-0.5">
          {
            authors.length > 0 && (
              <div class="flex items-center gap-1 min-w-0">
                <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <span class="truncate">{authors.join(', ')}{moreAuthors && ', …'}</span>
              </div>
            )
          }
          <div class="flex items-center gap-1">
            <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <time datetime={d.updatedAt}>{date(d.updatedAt)}</time>
          </div>
        </div>
      </div>
    </div>
    <p class="text-gray-600 dark:text-slate-300 text-sm line-clamp-2 mb-4 flex-1">{d.summary}</p>
    <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-100 dark:border-slate-800/50">
      <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-500/10 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-500/20">
        {d.stable.version}
      </span>
      <span class="text-blue-600 dark:text-blue-400 text-sm font-medium group-hover:translate-x-1 transition-transform flex items-center gap-1">
        {m.viewDetails}
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
        </svg>
      </span>
    </div>
  </a>
</li>
