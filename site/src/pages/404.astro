---
import Layout from '../layouts/Layout.astro';
import { MESSAGES } from '../lib/i18n.ts';

const en = MESSAGES.en;
const zh = MESSAGES['zh-CN'];
---

<Layout ui="en" title={`404 · ${en.siteTitle}`} description={en.notFoundTitle}>
  <div class="box mx-auto max-w-2xl px-6 py-16 text-center">
    <p class="font-mono text-5xl font-semibold text-muted">404</p>
    <h1 class="mt-4 text-2xl font-semibold">{en.notFoundTitle}</h1>
    <p class="mt-2 text-muted">{en.notFoundText}</p>
    <p class="mt-1 text-muted" lang="zh-CN">{zh.notFoundText}</p>
    <p class="mt-8 flex flex-wrap justify-center gap-2">
      <a href="/en/" class="btn btn-primary">{en.backToList}</a>
      <a href="/zh-CN/" lang="zh-CN" class="btn">{zh.backToList}</a>
    </p>
  </div>
</Layout>
