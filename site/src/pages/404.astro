---
import Layout from '../layouts/Layout.astro';
import { MESSAGES } from '../lib/i18n.ts';

const en = MESSAGES.en;
const zh = MESSAGES['zh-CN'];
---

<Layout ui="en" title={`404 · ${en.siteTitle}`} description={en.notFoundTitle}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <p class="text-6xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 via-violet-600 to-indigo-600 dark:from-blue-400 dark:via-violet-400 dark:to-indigo-400">404</p>
    <h1 class="mt-4 text-2xl font-bold text-gray-900 dark:text-white">{en.notFoundTitle}</h1>
    <p class="mt-2 text-gray-600 dark:text-slate-400">{en.notFoundText}</p>
    <p class="mt-1 text-gray-600 dark:text-slate-400" lang="zh-CN">{zh.notFoundText}</p>
    <p class="mt-8 flex justify-center gap-4 text-sm font-medium">
      <a href="/en/" class="px-4 py-2 rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors">{en.backToList}</a>
      <a href="/zh-CN/" lang="zh-CN" class="px-4 py-2 rounded-lg text-gray-700 dark:text-slate-300 bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 transition-colors">{zh.backToList}</a>
    </p>
  </div>
</Layout>
