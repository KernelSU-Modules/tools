{
  "name": "@kernelsu-modules/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build-pages.ts",
    "dev": "pnpm run build && wrangler pages dev --port 8787",
    "deploy": "pnpm run build && wrangler pages deploy --project-name kernelsu-developer-portal --branch main",
    "cron:dev": "wrangler dev --config cron/wrangler.toml --test-scheduled --port 8790",
    "cron:deploy": "wrangler deploy --config cron/wrangler.toml",
    "cron:build": "wrangler deploy --config cron/wrangler.toml --dry-run --outdir dist/cron",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "smoke": "wrangler dev --config test/smoke/wrangler.toml --port 8799"
  },
  "dependencies": {
    "@kernelsu-modules/github": "workspace:*",
    "@kernelsu-modules/schema": "workspace:*",
    "@kernelsu-modules/validator": "workspace:*",
    "hono": "^4.13.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@kernelsu-modules/render": "workspace:*",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "4.149.0"
  }
}
